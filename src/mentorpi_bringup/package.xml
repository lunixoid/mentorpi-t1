<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mentorpi_bringup</name>
  <version>0.11.0</version>
  <description>Stage 1 launch: chassis SIT, control mux (F06), lidar layer (F03), IMU layer (F04), camera layer (F05), person perception (F08), FollowPerson status (F10), motion control and obstacle avoidance (F11, F12), obstacle guard (F13, F14); no Hiwonder apps.</description>
  <maintainer email="lunix0x@gmail.com">Roman Kalashnikov</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mentorpi_control</exec_depend>
  <exec_depend>mentorpi_localization</exec_depend>
  <exec_depend>mentorpi_platform</exec_depend>
  <exec_depend>mentorpi_perception</exec_depend>
  <exec_depend>mentorpi_person_detect</exec_depend>
  <exec_depend>mission_control</exec_depend>
  <exec_depend>mentorpi_commands</exec_depend>
  <exec_depend>mentorpi_voice</exec_depend>
  <exec_depend>motion_control</exec_depend>
  <exec_depend>mentorpi_description</exec_depend>
  <exec_depend>mentorpi_calibration</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>hiwonder_controller</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

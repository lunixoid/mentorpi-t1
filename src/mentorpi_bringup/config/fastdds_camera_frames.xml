<?xml version="1.0" encoding="UTF-8" ?>
<!-- SD029: 8 MB receive buffer for camera frames (point cloud ~8.19 MB); default ~208 KB dropped frames. Not SLA. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_camera_frames</transport_id>
      <type>UDPv4</type>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="mentorpi_t1_camera_frames" is_default_profile="true">
    <rtps>
      <listenSocketBufferSize>8388608</listenSocketBufferSize>
      <userTransports>
        <transport_id>udp_camera_frames</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>

<?xml version="1.0" encoding="utf-8"?>
<robot name="imu" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="imu_link">
    <inertial>
      <origin xyz="-0.015992956442504 -0.0186967363878791 0.00080000000000012" rpy="0 0 0"/>
      <mass value="0.00900725791925823"/>
      <inertia
        ixx="6.0621502887195E-06"
        ixy="8.2009503850481E-10"
        ixz="1.00078505419116E-16"
        iyy="2.95825733414683E-06"
        iyz="4.74614002484179E-17"
        izz="9.01656451992273E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mentorpi_description/meshes/common/imu_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mentorpi_description/meshes/common/imu_link.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin
      xyz="$(arg imu_x) $(arg imu_y) $(arg imu_z)"
      rpy="$(arg imu_roll) $(arg imu_pitch) $(arg imu_yaw)"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
    <axis xyz="0 0 0"/>
  </joint>
</robot>

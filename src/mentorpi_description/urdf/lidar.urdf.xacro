<?xml version="1.0" encoding="utf-8"?>
<robot name="lidar" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="lidar_link">
    <inertial>
      <origin xyz="-0.000511459223461241 -0.00026215532436116 -0.0101267502723355" rpy="0 0 0"/>
      <mass value="0.165604343849592"/>
      <inertia
        ixx="5.88498679907636E-05"
        ixy="4.6459735242599E-07"
        ixz="-1.56610114830903E-07"
        iyy="5.96988334453293E-05"
        iyz="-8.03105723289238E-08"
        izz="0.000108238967260097"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mentorpi_description/meshes/common/lidar_link.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin
      xyz="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)"
      rpy="$(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <axis xyz="0 0 0"/>
  </joint>
</robot>
